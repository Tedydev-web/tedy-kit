{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/no-comments-gate.mjs\"", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor|Agent)$|^mcp__.*__ctx_(execute|execute_file|batch_execute)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/role-gate.mjs\"", "timeout": 20, "onFailure": "block" }
        ]
      },
      {
        "matcher": "^(Bash|Monitor)$|^mcp__.*__ctx_(execute|execute_file|batch_execute)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/git-gate.mjs\"", "timeout": 60, "onFailure": "block" }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor)$|^mcp__.*__ctx_(execute|execute_file|batch_execute)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/profile-guard-gate.mjs\"", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash|Monitor|Read|Grep|mcp__.*ctx_(execute|execute_file|batch_execute|index|fetch_and_index)",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tracker-token-gate.mjs\"", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "^(Bash|Monitor)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/reviewer-gate.mjs\"", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "^(Bash|Monitor)$|^mcp__.*__ctx_(execute|execute_file|batch_execute)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/review-run-gate.mjs\"", "timeout": 30, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^mcp__.*__ctx_(execute|execute_file|batch_execute)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/push-report.mjs\"", "timeout": 60 }
        ]
      },
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/publish-approval-ticket.mjs\"", "timeout": 15 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/job-session-hooks.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/job-session-hooks.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-hooks.mjs\" pending-handoffs", "timeout": 15 }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-hooks.mjs\" role-reminder", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-hooks.mjs\" ask-cards", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-hooks.mjs\" decision-nudge", "timeout": 15 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^tedy:(pm|dev|review|devops)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/job-session-hooks.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
