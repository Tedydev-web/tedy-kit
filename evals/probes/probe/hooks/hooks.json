{"hooks":{
 "PreToolUse":[{"matcher":"Bash","hooks":[
   {"type":"command","if":"Bash(git *)","command":"node \"${CLAUDE_PLUGIN_ROOT}/log.mjs\" if-git"},
   {"type":"command","if":"Bash(rtk *)","command":"node \"${CLAUDE_PLUGIN_ROOT}/log.mjs\" if-rtk"},
   {"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/log.mjs\" all-bash"}]}],
 "SessionStart":[
   {"matcher":"startup","hooks":[{"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/log.mjs\" startup"}]},
   {"matcher":"compact","hooks":[{"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/log.mjs\" compact"}]}]
}}
